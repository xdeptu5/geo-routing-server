# __pycache__/*.pyc на уровне подкаталогов НЕ отсекаются паттернами без ** —
# иначе в образ попадает чужой байткод (проверено сборкой).
__pycache__
**/__pycache__
*.py[cod]
**/*.py[cod]
custom_geo/*.dat
*.log
.env
token.txt
*.md
LICENSE
*.example
