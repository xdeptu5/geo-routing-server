# ==============================================================================
# CADDY CONFIGURATION SNIPPET FOR GEO ROUTING SERVER
# ==============================================================================
# Добавьте этот блок в ваш Caddyfile на сервере.
# Caddy автоматически получит и будет продлевать бесплатный SSL-сертификат (HTTPS).
# ==============================================================================

# Вариант 1: Если Caddy установлен прямо на хосте
sub.example.com {
    reverse_proxy 127.0.0.1:8080
}

# Вариант 2: Если Caddy работает в Docker-контейнере в одной сети с geo-routing-server
# (раскомментируйте networks в compose.yaml)
# sub.example.com {
#     reverse_proxy geo-routing-server:80
# }
