# ==============================================================================
# CADDY CONFIGURATION SNIPPET FOR GEO ROUTING SERVER
# ==============================================================================
# Добавьте подходящий блок в ваш Caddyfile на сервере.
# Caddy автоматически получит и будет продлевать бесплатный SSL-сертификат (HTTPS).
# ==============================================================================

# ------------------------------------------------------------------------------
# ВАРИАНТ 1: Совместное использование домена с другими сервисами
# (например, подписками Remnawave / Marzban на том же домене sub.example.com)
# ------------------------------------------------------------------------------
# Замените <ROUTING_TOKEN> на значение вашего ROUTING_TOKEN из файла .env.

# sub.example.com {
#     # Перенаправляем запросы по токену в geo-routing-server:
#     handle /<ROUTING_TOKEN>/* {
#         reverse_proxy 127.0.0.1:8080
#     }
#
#     # Все остальные запросы отдаёт ваш основной сервис (Marzban, Remnawave, сайт):
#     handle {
#         reverse_proxy 127.0.0.1:8000 # порт вашего основного сервиса
#     }
# }

# ------------------------------------------------------------------------------
# ВАРИАНТ 2: Выделенный отдельный поддомен только под geo-routing-server
# ------------------------------------------------------------------------------
sub.example.com {
    reverse_proxy 127.0.0.1:8080
}

# ------------------------------------------------------------------------------
# ВАРИАНТ 3: Если Caddy и geo-routing-server работают в одной Docker-сети
# ------------------------------------------------------------------------------
# sub.example.com {
#     handle /<ROUTING_TOKEN>/* {
#         reverse_proxy geo-routing-server:80
#     }
#     handle {
#         reverse_proxy my-main-app:8000
#     }
# }
