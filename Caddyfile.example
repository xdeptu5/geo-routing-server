# ==============================================================================
# CADDY CONFIGURATION SNIPPET FOR GEO ROUTING SERVER
# ==============================================================================
# Добавьте подходящий блок в ваш Caddyfile на сервере.
# Caddy автоматически получит и будет продлевать бесплатный SSL-сертификат (HTTPS).
# ==============================================================================

# ------------------------------------------------------------------------------
# ВАРИАНТ 1 (СТАНДАРТНЫЙ): Выделенный поддомен (например, geo.example.com)
# Идеально для работы в связке с Remnawave / Marzban (исключает конфликты путей)
# ------------------------------------------------------------------------------
geo.example.com {
    reverse_proxy 127.0.0.1:8080
}

# ------------------------------------------------------------------------------
# ВАРИАНТ 2: Если Caddy и geo-routing-server работают в одной Docker-сети
# ------------------------------------------------------------------------------
# geo.example.com {
#     reverse_proxy geo-routing-server:80
# }

# ------------------------------------------------------------------------------
# ВАРИАНТ 3: Проксирование отдельного пути на общем веб-сайте
# ------------------------------------------------------------------------------
# example.com {
#     handle /<ROUTING_TOKEN>/* {
#         reverse_proxy 127.0.0.1:8080
#     }
#     handle {
#         reverse_proxy 127.0.0.1:3000 # ваш основной сайт
#     }
# }
