# ==============================================================================
# NGINX CONFIGURATION SNIPPET FOR GEO ROUTING SERVER
# ==============================================================================
# Добавьте этот блок внутри вашей секции `server { ... }` для домена (sub.example.com).
# ==============================================================================

# Вариант 1: Если Nginx установлен прямо на хосте
location / {
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Вариант 2: Если Nginx работает в Docker-контейнере в одной сети с geo-routing-server
