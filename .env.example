# ==============================================================================
# GEO ROUTING SERVER CONFIGURATION
# ==============================================================================

# Публичный домен, на котором будут отдаваться файлы (с настроенным HTTPS)
DOMAIN=geo.example.com

# Секретный URL-токен (произвольная строка без слешей и пробелов)
# Сгенерировать можно командой: openssl rand -hex 16
ROUTING_TOKEN=change_me_to_random_secret_token

# Выборочная раздача клиентов и модулей через запятую:
# - HAPP,INCY      (по умолчанию отдаются оба клиента целиком)
# - INCY           (только базы и JSON/DEEPLINK для Incy)
# - HAPP_DEEPLINK  (только локальный генератор диплинков для Remnawave-апдейтера, без раздачи баз)
# - HAPP_GEO       (только публичная раздача баз geoip/geosite для Happ)
# - HAPP           (полный Happ: локальный генератор + раздача баз)
ENABLED_CLIENTS=HAPP,INCY

# (Опционально) Внешний базовый URL к geo-базам, если базы отдаются с другого сервера:
# Например, если базы на втором сервере: https://geo-node.example.com/секретный_токен/HAPP
# PUBLIC_GEO_BASE_URL=https://geo-node.example.com/secret_token/HAPP

# Локальный интерфейс и порт (доступен только локально для вашего реверс-прокси с HTTPS):
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Расписание запуска по UTC (cron-формат: минута час день месяц день_недели)
SCHEDULE=40 8 * * *

# Выполнять синхронизацию сразу при первом старте контейнера (true/false)
SYNC_ON_START=true

# (Опционально) Свои прямые ссылки на geo-базы (если не указаны, берутся из репозитория):
# GEOIP_SOURCE_URL=https://example.com/geoip.dat
# GEOSITE_SOURCE_URL=https://example.com/geosite.dat

# (Опционально) Свой репозиторий с шаблонами правил:
# ROUTING_SOURCE_REPO=https://raw.githubusercontent.com/hydraponique/roscomvpn-routing/main

# (Опционально) Уведомления и алерты об ошибках в Telegram:
# TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_CHAT_ID=-1001234567890
# TELEGRAM_THREAD_ID=123
# TELEGRAM_NOTIFY_SUCCESS=false

# (Опционально) Название общей Docker-сети, если ваш Caddy/Nginx/Traefik работает в Docker:
# DOCKER_PROXY_NETWORK=proxy_network
