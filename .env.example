# ==============================================================================
# GEO ROUTING SERVER CONFIGURATION
# ==============================================================================

# Публичный домен, на котором будут отдаваться файлы (с настроенным HTTPS)
DOMAIN=geo.example.com

# Секретный URL-токен: минимум 4 символа A-Z, a-z, 0-9, _ или -
# Сгенерировать можно командой: openssl rand -hex 16
ROUTING_TOKEN=change_me_to_random_secret_token

# Выборочная раздача клиентов и модулей через запятую:
# - HAPP,INCY      (по умолчанию отдаются оба клиента целиком)
# - INCY           (только базы и JSON/DEEPLINK для Incy)
# - HAPP_DEEPLINK  (только локальный генератор диплинков для Remnawave, без раздачи баз)
# - HAPP_GEO       (только публичная раздача баз geoip/geosite для Happ)
# - HAPP           (полный Happ: генератор + раздача баз)
ENABLED_CLIENTS=HAPP,INCY

# (Опционально) Внешний базовый URL к geo-базам, если базы отдаются с другого сервера:
# Можно указать корень с токеном (подставит /HAPP или /INCY автоматически):
# PUBLIC_GEO_BASE_URL=https://geo-node.example.com/secret_token

# ==============================================================================
# ПРЯМАЯ ИНТЕГРАЦИЯ С REMNAWAVE API (БЕЗ СТОРОННИХ АПДЕЙТЕРОВ)
# ==============================================================================
# REMNAWAVE_BASE_URL=http://remnawave:3000/api
# REMNAWAVE_TOKEN=ваш_jwt_токен_администратора_из_remnawave

# Привязка правил к сквадам Remnawave (External Squads):
# REMNAWAVE_SQUAD_1_UUID=23c97b42-289d-490a-ad73-bd17ab426657
# REMNAWAVE_SQUAD_1_RULE=JSONSUB.JSON

# REMNAWAVE_SQUAD_2_UUID=aae87204-e36a-41cb-8f7c-485742bf556c
# REMNAWAVE_SQUAD_2_RULE=WHITELIST.JSON

# (Опционально) Глобальное правило для всех подписок:
# REMNAWAVE_GLOBAL_RULE=DEFAULT.JSON

# (Опционально) Если панель Remnawave защищена Cloudflare Zero Trust (Service Token):
# CLOUDFLARE_ZERO_TRUST_CLIENT_ID=ваш_cf_client_id.access
# CLOUDFLARE_ZERO_TRUST_CLIENT_SECRET=ваш_cf_client_secret_hash

# ==============================================================================
# СЕРВЕРНЫЕ НАСТРОЙКИ
# ==============================================================================
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
SCHEDULE=0 10 * * *
SYNC_ON_START=true

# (Опционально) Кастомные источники geo-баз (переопределяют URL из DEFAULT.JSON):
# GEOIP_SOURCE_URL=https://example.com/custom/geoip.dat
# GEOSITE_SOURCE_URL=https://example.com/custom/geosite.dat

# (Опционально) Уведомления и алерты об ошибках в Telegram:
# TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_CHAT_ID=-1001234567890
# TELEGRAM_THREAD_ID=123
# TELEGRAM_NOTIFY_SUCCESS=false

# (Опционально) Имя существующей сети Remnawave. Эта переменная действует после
# включения блока networks в compose.yaml по инструкции в README.
# DOCKER_NETWORK=remnawave-network
